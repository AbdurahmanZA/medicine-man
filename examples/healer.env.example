# /etc/healer/healer.env (root 600). Generate secrets with: openssl rand -hex 32
HEALER_TOKEN=change-me-monitor-token
HEALER_VIEW_TOKEN=change-me-view-key
HEALER_WEB_USER=admin
HEALER_WEB_PASS=change-me
HEALER_PUBLIC_BASE=http://healer.lan:3050
HEALER_BIND=0.0.0.0
# PORT=3050
# HEALER_TRUST_PROXY=1              # only when a reverse proxy you run sets X-Forwarded-For

# Model (Claude Code aliases or full ids). Escalation runs only on a low-confidence answer.
HEALER_MODEL=haiku
# HEALER_ESCALATE_MODEL=sonnet

# Alerts: email (SMTP) and/or a webhook that accepts {"text": "..."}
# HEALER_SMTP_HOST=smtp.example.com
# HEALER_SMTP_PORT=587
# HEALER_SMTP_TLS=starttls
# HEALER_SMTP_USER=healer@example.com
# HEALER_SMTP_PASS=
# HEALER_EMAIL_FROM=Healer <healer@example.com>
# HEALER_EMAIL_TO=you@example.com
# HEALER_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: your monitor's re-probe endpoint, used when an incident has no "probe"
# HEALER_REPROBE_URL=http://monitor.lan:3022/reprobe
